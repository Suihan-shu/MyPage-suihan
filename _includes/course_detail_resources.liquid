{% assign t = site.data.i18n.zh %}
{% assign course = site.data.course_resources | where: 'id', include.course_id | first %}

{% if course and course.resources %}
  {% assign ordered_types = 'review|slides|exam|solution|assignment|project|code|book' | split: '|' %}
  {% for type_name in ordered_types %}
    {% assign items = course.resources | where: 'type', type_name %}
    {% if items and items.size > 0 %}
      {% assign section_id = 'course-' | append: type_name %}
      <details class="course-type-details" open id="{{ section_id }}">
        <summary class="course-type-summary">
          <span class="course-type-label">
            {% case type_name %}
              {% when 'review' %}{{ t.courses.section_review | default: 'Review' }}
              {% when 'slides' %}{{ t.courses.section_slides | default: 'Slides' }}
              {% when 'exam' %}{{ t.courses.section_exam | default: 'Final Exams' }}
              {% when 'solution' %}{{ t.courses.section_solution | default: 'Final Solutions' }}
              {% when 'assignment' %}{{ t.courses.section_assignment | default: 'Assignments' }}
              {% when 'project' %}{{ t.courses.section_project | default: 'Project' }}
              {% when 'code' %}{{ t.courses.section_code | default: 'Code' }}
              {% when 'book' %}{{ t.courses.section_book | default: 'Book' }}
              {% else %}{{ type_name }}
            {% endcase %}
          </span>
          <span class="course-type-count">{{ items.size }} {{ t.courses.resources_count | default: 'resources' }}</span>
        </summary>
        <div class="course-resource-table-wrap">
          <table class="table table-sm course-resource-table">
            <thead>
              <tr>
                <th>{{ t.courses.resource_name | default: 'Resource' }}</th>
                <th>{{ t.courses.resource_meta | default: 'Meta' }}</th>
                <th>{{ t.courses.resource_links | default: 'Access' }}</th>
              </tr>
            </thead>
            <tbody>
              {% for item in items %}
                {% include course_resource_row.liquid item=item t=t %}
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    {% endif %}
  {% endfor %}
{% endif %}

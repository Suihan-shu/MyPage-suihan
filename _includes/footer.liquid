{% capture footer_contents %}
  {% assign t = site.data.i18n.zh %}
  &copy; {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. 
  {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">法律声明</a>。
  {% endif %}
  {% if site.last_updated %}
    {% assign footer_date_format = t.footer.date_format | default: '%Y年%m月%d日' %}
    {{ t.footer.last_updated_prefix | default: '最后更新于' }} {{ 'now' | date: footer_date_format }}。
  {% endif %}
  <a href="{{ '/admin/' | relative_url }}" class="footer-admin-link" title="站长管理与发布" aria-label="管理后台"><i class="fa-solid fa-lock"></i></a>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

{% assign email_contact = site.data.socials.email_contact %}
{% if email_contact and email_contact.emails %}
  <div
    id="contact-email"
    class="contact-qr-modal contact-email-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="邮箱"
    tabindex="-1"
  >
    <button class="contact-qr-modal__close" type="button" aria-label="关闭">
      &times;
    </button>
    <div class="contact-qr-modal__panel contact-email-modal__panel">
      <h2>邮箱</h2>
      <ul class="contact-email-list">
        {% for email in email_contact.emails %}
          <li>{{ email }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endif %}

{% assign qr_social_keys = 'wechat_qr,qq_qr' | split: ',' %}
{% for social_key in qr_social_keys %}
  {% assign social = site.data.socials[social_key] %}
  {% if social and social.qr_img %}
    {% assign modal_key = social_key | replace: '_qr', '' %}
    <div
      id="contact-qr-{{ modal_key }}"
      class="contact-qr-modal"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label="{{ social.title }}"
      tabindex="-1"
    >
      <button class="contact-qr-modal__close" type="button" aria-label="关闭">
        &times;
      </button>
      <div class="contact-qr-modal__panel">
        <img
          src="{{ social.qr_img | prepend: 'assets/img/' | relative_url }}"
          alt="{{ social.alt | default: social.alt_zh | default: social.title }}"
        >
        <p>{{ social.title }}</p>
      </div>
    </div>
  {% endif %}
{% endfor %}

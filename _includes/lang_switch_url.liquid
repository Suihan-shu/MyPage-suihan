{% assign current_page = include.current_page %}
{% assign default_lang = site.default_lang | default: 'en' %}
{% assign current_lang = current_page.lang | default: site.active_lang | default: default_lang %}
{% assign alt_url = '' %}
{% assign target_lang = '' %}
{% assign is_archive_like = false %}
{% if current_page.layout == 'archive' or current_page.type == 'tags' or current_page.type == 'categories' or current_page.type == 'year' %}
  {% assign is_archive_like = true %}
{% endif %}

{% if current_page.lang-ref and is_archive_like == false %}
  {% for post in site.posts %}
    {% assign post_lang = post.lang | default: default_lang %}
    {% if post.lang-ref == current_page.lang-ref and post_lang != current_lang %}
      {% assign alt_url = post.url %}
      {% assign target_lang = post_lang %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if alt_url == '' %}
    {% for p in site.pages %}
      {% assign page_lang = p.lang | default: default_lang %}
      {% if p.lang-ref == current_page.lang-ref and page_lang != current_lang %}
        {% assign alt_url = p.url %}
        {% assign target_lang = page_lang %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% if alt_url == '' and is_archive_like == false %}
  {% for p in site.pages %}
    {% assign page_lang = p.lang | default: default_lang %}
    {% if p.permalink == current_page.permalink and page_lang != current_lang %}
      {% unless p.url contains '/assets/' %}
        {% assign alt_url = p.url %}
        {% assign target_lang = page_lang %}
        {% break %}
      {% endunless %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if target_lang == '' %}
  {% for lang_code in site.languages %}
    {% if lang_code != current_lang %}
      {% assign target_lang = lang_code %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if target_lang == '' %}
  {% assign target_lang = default_lang %}
{% endif %}

{% if alt_url == '' %}
  {% assign current_url = current_page.url | remove_first: site.baseurl %}
  {% assign current_prefix = '/' | append: current_lang %}
  {% assign current_prefix_size = current_prefix | size %}
  {% assign current_head = current_url | slice: 0, current_prefix_size %}

  {% if current_lang != default_lang and current_url == current_prefix %}
    {% assign current_url = '/' %}
  {% elsif current_lang != default_lang and current_head == current_prefix and current_url | slice: current_prefix_size, 1 == '/' %}
    {% assign current_url = current_url | remove_first: current_prefix %}
  {% endif %}

  {% if current_url == '' %}
    {% assign current_url = '/' %}
  {% endif %}

  {% assign alt_url = current_url %}
{% endif %}

{% if alt_url == '' %}
  {% assign alt_url = '/' %}
{% endif %}

{% assign normalized_alt = alt_url | remove_first: site.baseurl %}
{% assign target_prefix = '/' | append: target_lang %}
{% assign first_char = normalized_alt | slice: 0, 1 %}
{% if first_char != '/' %}
  {% assign normalized_alt = '/' | append: normalized_alt %}
{% endif %}

{% if target_lang == default_lang %}
  {% for lang_code in site.languages %}
    {% if lang_code != default_lang %}
      {% assign lang_prefix = '/' | append: lang_code %}
      {% assign prefix_size = lang_prefix | size %}
      {% assign alt_head = normalized_alt | slice: 0, prefix_size %}
      {% if normalized_alt == lang_prefix %}
        {% assign normalized_alt = '/' %}
      {% elsif alt_head == lang_prefix and normalized_alt | slice: prefix_size, 1 == '/' %}
        {% assign normalized_alt = normalized_alt | remove_first: lang_prefix %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign target_prefix_size = target_prefix | size %}
  {% assign target_head = normalized_alt | slice: 0, target_prefix_size %}
  {% if normalized_alt == '/' %}
    {% assign normalized_alt = target_prefix | append: '/' %}
  {% elsif target_head != target_prefix %}
    {% assign normalized_alt = target_prefix | append: normalized_alt %}
  {% elsif normalized_alt == target_prefix %}
    {% assign normalized_alt = target_prefix | append: '/' %}
  {% endif %}
{% endif %}

{% assign alt_url = normalized_alt %}

{{ alt_url }}

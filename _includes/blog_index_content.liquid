<div class="post">

{% assign t = site.data.i18n.zh %}
{% assign blog_title = t.blog.title | default: site.blog_name %}
{% assign blog_subtitle = t.blog.subtitle | default: site.blog_description %}
{% assign series_title = t.blog.series_title | default: "系列专栏" %}
{% assign read_label = t.blog.read_label | default: "分钟阅读" %}
{% assign date_format = t.post.date_format | default: "%Y年%m月%d日" %}

{% assign blog_name_size = blog_title | size %}
{% assign blog_description_size = blog_subtitle | size %}

{% if blog_name_size > 0 or blog_description_size > 0 %}
  <div class="header-bar">
    <h1>{{ blog_title }}</h1>
    <h2>{{ blog_subtitle }}</h2>
  </div>
{% endif %}

{% assign active_posts = site.posts | where: "lang", "zh" %}
{% assign all_tags = "" %}
{% assign all_categories = "" %}
{% for post in active_posts %}
  {% for tag in post.tags %}
    {% assign tag_str = tag | append: "|||" %}
    {% unless all_tags contains tag_str %}
      {% assign all_tags = all_tags | append: tag_str %}
    {% endunless %}
  {% endfor %}
  {% for cat in post.categories %}
    {% assign cat_str = cat | append: "|||" %}
    {% unless all_categories contains cat_str %}
      {% assign all_categories = all_categories | append: cat_str %}
    {% endunless %}
  {% endfor %}
{% endfor %}
{% assign all_tags_uniq = all_tags | split: "|||" | sort %}
{% assign all_cats_uniq = all_categories | split: "|||" | sort %}

{% assign blog_base = '/blog/' %}

{% if all_cats_uniq.size > 0 or all_tags_uniq.size > 0 %}
  <div class="tag-category-list">
    <ul class="p-0 m-0">
      {% if all_cats_uniq.size > 0 %}
        {% for category in all_cats_uniq %}
          {% if category != "" %}
            {% assign category_slug = category | slugify %}
            <li>
              <i class="fa-solid fa-tag fa-sm"></i>
              <a href="{{ blog_base | append: 'category/' | append: category_slug | append: '/' | relative_url }}">{{ category }}</a>
            </li>
            {% unless forloop.last %}
              <p>&bull;</p>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% for tag in all_tags_uniq %}
          {% if tag != "" %}
            {% assign tag_slug = tag | slugify %}
            <li>
              <i class="fa-solid fa-tag fa-sm"></i>
              <a href="{{ blog_base | append: 'tag/' | append: tag_slug | append: '/' | relative_url }}">{{ tag }}</a>
            </li>
            {% unless forloop.last %}
              <p>&bull;</p>
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </ul>
  </div>
{% endif %}

<!-- Blog Heatmap -->
{% include blog_heatmap.liquid %}

<!-- Series Section -->
{% assign current_series = site.series | where: "lang", "zh" | sort: "importance" %}
{% if current_series.size > 0 %}
  <h3 class="mt-4 series-section-title"><strong>{{ series_title }}</strong></h3>
  <div class="row row-cols-1 row-cols-md-2 g-4 mb-5 series-grid">
    {% for s in current_series %}
      <div class="col">
        <a href="{{ s.url | relative_url }}" class="text-decoration-none">
          <div class="card repo-card h-100 p-3 series-card">
            <div class="card-body">
              <h4 class="card-title series-card-title">
                <i class="fa-solid fa-layer-group fa-sm"></i> {{ s.title }}
              </h4>
              <p class="card-text">{{ s.description }}</p>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% assign featured_posts = site.posts | where: "lang", "zh" | where: "featured", "true" %}
{% if featured_posts.size > 0 %}
  <br>
  <div class="container featured-posts">
    {% assign is_even = featured_posts.size | modulo: 2 %}
    <div class="row row-cols-{% if featured_posts.size <= 2 or is_even == 0 %}2{% else %}3{% endif %}">
      {% for post in featured_posts %}
        <div class="col mb-4">
          <a href="{{ post.url | relative_url }}" class="text-decoration-none">
            <div class="card repo-card h-100 p-3">
              <div class="card-body">
                <div class="float-right">
                  <i class="fa-solid fa-thumbtack fa-fw"></i>
                </div>
                <h3 class="card-title text-lowercase">{{ post.title }}</h3>
                <p class="card-text">{{ post.description }}</p>
                {% if post.external_source == blank %}
                  {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
                {% else %}
                  {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
                {% endif %}
                {% assign year = post.date | date: "%Y" %}
                <p class="post-meta">
                  {{ read_time }} {{ read_label }} &nbsp; &middot; &nbsp;
                    <a href="{{ blog_base | append: year | append: '/' | relative_url }}">
                    <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
                  </a>
                </p>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
  <hr>
{% endif %}

<ul class="post-list">
  {% if page.pagination.enabled %}
    {% assign postlist = paginator.posts | where: "lang", "zh" %}
  {% else %}
    {% assign postlist = site.posts | where: "lang", "zh" %}
  {% endif %}

  {% for post in postlist %}
    {% if post.external_source == blank %}
      {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
    {% else %}
      {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
    {% endif %}
    {% assign year = post.date | date: "%Y" %}
    {% assign tags = post.tags | join: "" %}
    {% assign categories = post.categories | join: "" %}

    <li>
      {% if post.thumbnail %}
        <div class="row">
          <div class="col-sm-9">
      {% endif %}
      <h3>
        {% if post.redirect == blank %}
          <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
        {% elsif post.redirect contains '://' %}
          <a class="post-title" href="{{ post.redirect }}" target="_blank">{{ post.title }}</a>
          <svg width="2rem" height="2rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
            <path d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9" class="icon_svg-stroke" stroke="#999" stroke-width="1.5" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        {% else %}
          <a class="post-title" href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
        {% endif %}
      </h3>
      <p>{{ post.description }}</p>
      <p class="post-meta">
        {{ read_time }} {{ read_label }} &nbsp; &middot; &nbsp;
        {{ post.date | date: date_format }}
        {% if post.external_source %}
          {% assign published_in_prefix = t.blog.published_in_prefix | default: "" %}
          {% if published_in_prefix != "" %}
            &nbsp; &middot; &nbsp; {{ published_in_prefix }} {{ post.external_source }}
          {% else %}
            &nbsp; &middot; &nbsp; {{ post.external_source }}
          {% endif %}
        {% endif %}
      </p>
      <p class="post-tags">
        <a href="{{ blog_base | append: year | append: '/' | relative_url }}">
          <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
        </a>

        {% if categories != "" %}
          &nbsp; &middot; &nbsp;
          {% for category in post.categories %}
            {% assign category_slug = category | slugify %}
            <a href="{{ blog_base | append: 'category/' | append: category_slug | append: '/' | relative_url }}">
              <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
            </a>
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% elsif tags != "" %}
          &nbsp; &middot; &nbsp;
          {% for tag in post.tags %}
            {% assign tag_slug = tag | slugify %}
            <a href="{{ blog_base | append: 'tag/' | append: tag_slug | append: '/' | relative_url }}">
              <i class="fa-solid fa-tag fa-sm"></i> {{ tag }}
            </a>
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}
      </p>

      {% if post.thumbnail %}
          </div>
          <div class="col-sm-3">
            <img class="card-img" src="{{ post.thumbnail | relative_url }}" style="object-fit: cover; height: 90%" alt="{{ post.title }}缩略图">
          </div>
        </div>
      {% endif %}
    </li>
  {% endfor %}
</ul>

{% if page.pagination.enabled %}
  {% include pagination.liquid %}
{% endif %}

</div>

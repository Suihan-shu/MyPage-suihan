{% assign t = site.data.i18n.zh %}
{% assign resource_courses = site.data.course_resources %}

{% if resource_courses and resource_courses.size > 0 %}
  <div class="courses course-resources">
    {% assign current_semester = '' %}
    {% for course in resource_courses %}
      {% assign course_semester = course.semester_zh | default: course.semester %}

      {% if course_semester != current_semester %}
        {% if current_semester != '' %}
          </div>
        {% endif %}
        <h2 class="semester-group">{{ course_semester }}</h2>
        <div class="semester-courses-grid">
        {% assign current_semester = course_semester %}
      {% endif %}

      {% assign course_title = course.title_zh | default: course.title %}
      {% assign course_summary = course.summary_zh | default: course.summary %}

      {% assign ordered_types = 'review|slides|exam|solution|assignment|project|code|book' | split: '|' %}

      <div class="course-card">
        <div class="course-card-header">
          <div class="course-card-title-row">
            <h3 class="course-card-title">
              <a href="{{ '/courses/' | append: course.slug | append: '/' | relative_url }}">{{ course_title }}</a>
            </h3>
            {% if course.term %}
              <span class="course-term">{{ course.term }}</span>
            {% endif %}
          </div>
          {% if course_summary %}
            <p class="course-card-summary">{{ course_summary }}</p>
          {% endif %}
        </div>

        <div class="course-card-body">
          {% for type_name in ordered_types %}
            {% assign items = course.resources | where: 'type', type_name %}
            {% if items and items.size > 0 %}
              {% assign card_section_id = 'card-' | append: course.id | append: '-' | append: type_name %}
              <details class="course-card-section" id="{{ card_section_id }}">
                <summary class="course-card-section-summary">
                  <span class="course-card-section-label">
                    {% case type_name %}
                      {% when 'review' %}{{ t.courses.section_review | default: 'Review' }}
                      {% when 'slides' %}{{ t.courses.section_slides | default: 'Slides' }}
                      {% when 'exam' %}{{ t.courses.section_exam | default: 'Final Exams' }}
                      {% when 'solution' %}{{ t.courses.section_solution | default: 'Final Solutions' }}
                      {% when 'assignment' %}{{ t.courses.section_assignment | default: 'Assignments' }}
                      {% when 'project' %}{{ t.courses.section_project | default: 'Project' }}
                      {% when 'code' %}{{ t.courses.section_code | default: 'Code' }}
                      {% when 'book' %}{{ t.courses.section_book | default: 'Book' }}
                      {% else %}{{ type_name }}
                    {% endcase %}
                  </span>
                  <span class="course-card-section-count">{{ items.size }}</span>
                </summary>
                <ul class="course-card-items">
                  {% for item in items %}
                    {% assign item_name = item.name_zh | default: item.name %}
                    <li class="course-card-item">
                      <span class="course-card-item-name">{{ item_name }}</span>
                      <span class="course-card-item-actions">
                        {% if item.preview_url and item.preview_url != blank %}
                          <a href="{{ item.preview_url }}" target="_blank" rel="noopener noreferrer" title="{{ t.courses.preview | default: 'Preview' }}">
                            <i class="fa-solid fa-eye"></i>
                          </a>
                        {% endif %}
                        {% if item.download_url and item.download_url != blank %}
                          <a href="{{ item.download_url }}" target="_blank" rel="noopener noreferrer" title="{{ t.courses.download | default: 'Download' }}">
                            <i class="fa-solid fa-download"></i>
                          </a>
                        {% endif %}
                      </span>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            {% endif %}
          {% endfor %}
        </div>

        <div class="course-card-footer">
          <a class="course-card-more" href="{{ '/courses/' | append: course.slug | append: '/' | relative_url }}">
            {{ t.courses.enter_course | default: '课程详情' }} &rarr;
          </a>
        </div>
      </div>
    {% endfor %}
    {% if current_semester != '' %}
      </div>
    {% endif %}
  </div>
{% else %}
  <p>{{ t.courses.empty | default: '暂无课程内容。' }}</p>
{% endif %}

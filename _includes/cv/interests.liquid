{% comment %}
  Unified interests entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="interest-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      <strong>{{ entry.name }}:</strong>
      {% if entry.keywords %}
        {% assign keyword_list = entry.keywords %}
        {% if entry.keywords contains ',' %}
          {% assign keyword_list = entry.keywords | split: ',' %}
        {% endif %}
        {% for keyword in keyword_list %}
          {% if forloop.last %}
            {{ keyword | strip }}
          {% else %}
            {{ keyword | strip }},
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .interest-item {
    padding: 0.5rem 0;
  }
</style>

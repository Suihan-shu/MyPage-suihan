{% comment %}
  Unified interests & hobbies entry renderer - clean and consistent with skills styling
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    {% if entry and entry != '' %}
      <div class="interest-item">
        {% assign cat_name = entry.name %}
        {% if cat_name == nil or cat_name == '' %}
          {% assign cat_name = entry.分类 %}
        {% endif %}
        {% if cat_name == nil or cat_name == '' %}
          {% assign cat_name = entry.名称 %}
        {% endif %}

        {% if cat_name and cat_name != '' %}
          <strong>{{ cat_name }}:</strong>
        {% endif %}

        {% assign kw_list = entry.keywords %}
        {% if kw_list == nil %}
          {% assign kw_list = entry.items %}
        {% endif %}
        {% if kw_list == nil %}
          {% assign kw_list = entry.爱好 %}
        {% endif %}

        {% if kw_list %}
          {% if kw_list.first %}
            {% for kw in kw_list %}
              {% if forloop.last %}
                {{ kw | strip }}
              {% else %}
                {{ kw | strip }},
              {% endif %}
            {% endfor %}
          {% else %}
            {% assign kws = kw_list | split: ',' %}
            {% for kw in kws %}
              {% if forloop.last %}
                {{ kw | strip }}
              {% else %}
                {{ kw | strip }},
              {% endif %}
            {% endfor %}
          {% endif %}
        {% elsif entry.first == nil %}
          {{ entry }}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  .interest-item {
    padding: 0.5rem 0;
  }
</style>

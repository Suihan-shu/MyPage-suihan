{% comment %}
  Unified interests & hobbies entry renderer with Chinese/English support
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    {% if entry and entry != '' %}
      <div class="interest-item py-1">
        {% if entry.name or entry.分类 or entry.名称 %}
          {% assign cat_name = entry.name | default: entry.分类 | default: entry.名称 %}
          <strong><i class="fa-solid fa-heart mr-1 text-danger"></i> {{ cat_name }}：</strong>
        {% endif %}

        {% assign kw_raw = entry.keywords | default: entry.items | default: entry.爱好 | default: entry.内容 %}
        {% if kw_raw %}
          {% if kw_raw.first %}
            {% for kw in kw_raw %}
              <span class="badge badge-light border mr-1">{{ kw }}</span>
            {% endfor %}
          {% else %}
            {% assign kws = kw_raw | split: ',' %}
            {% for kw in kws %}
              <span class="badge badge-light border mr-1">{{ kw | strip }}</span>
            {% endfor %}
          {% endif %}
        {% elsif entry and entry != '' and entry.name == nil %}
          <span class="badge badge-light border mr-1">{{ entry }}</span>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

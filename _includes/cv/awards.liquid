{% comment %}
  Unified awards entry renderer matching the requested card list layout
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush p-0 m-0">
  {% for entry in entries %}
    {% if entry and entry != '' %}
      {% assign award_title = entry.title %}
      {% if award_title == nil or award_title == '' %}
        {% assign award_title = entry.奖项 %}
      {% endif %}
      {% if award_title == nil or award_title == '' %}
        {% assign award_title = entry.奖项名称 %}
      {% endif %}
      {% if award_title == nil or award_title == '' %}
        {% assign award_title = entry.name %}
      {% endif %}

      {% assign awarder = entry.awarder %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.institution %}
      {% endif %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.颁发单位 %}
      {% endif %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.颁发机构 %}
      {% endif %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.organization %}
      {% endif %}

      {% assign award_date = entry.date %}
      {% if award_date == nil or award_date == '' %}
        {% assign award_date = entry.year %}
      {% endif %}
      {% if award_date == nil or award_date == '' %}
        {% assign award_date = entry.获奖时间 %}
      {% endif %}
      {% if award_date == nil or award_date == '' %}
        {% assign award_date = entry.时间 %}
      {% endif %}

      {% if award_title and award_title != '' %}
        <li class="list-group-item px-0 py-3 border-bottom">
          <div class="row align-items-center">
            {% if award_date and award_date != '' %}
              <div class="col-auto text-center" style="min-width: 85px;">
                <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle shadow-sm py-2 px-3" style="font-size: 0.85rem; border-radius: 4px;">
                  {{ award_date }}
                </span>
              </div>
              <div class="col pl-md-3">
            {% else %}
              <div class="col-12">
            {% endif %}
                <h6 class="title font-weight-bold mb-1" style="font-size: 1.05rem; line-height: 1.4;">
                  {% if entry.url %}
                    <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ award_title }}</a>
                  {% else %}
                    {{ award_title }}
                  {% endif %}
                </h6>

                {% if awarder and awarder != '' %}
                  <div class="text-secondary" style="font-size: 0.95rem; line-height: 1.4;">
                    {{ awarder }}
                  </div>
                {% endif %}

                {% if entry.summary and entry.summary != '' and entry.summary.first == nil %}
                  <div class="text-muted mt-1" style="font-size: 0.88rem;">
                    {{ entry.summary }}
                  </div>
                {% endif %}
              </div>
          </div>
        </li>
      {% endif %}
    {% endif %}
  {% endfor %}
</ul>

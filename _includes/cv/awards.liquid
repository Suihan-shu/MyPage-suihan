{% comment %}
  Unified awards entry renderer with clean styling and robust field extraction
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% if entry and entry != '' %}
      {% assign award_title = entry.title %}
      {% if award_title == nil or award_title == '' %}
        {% assign award_title = entry.奖项 %}
      {% endif %}
      {% if award_title == nil or award_title == '' %}
        {% assign award_title = entry.奖项名称 %}
      {% endif %}
      {% if award_title == nil or award_title == '' %}
        {% assign award_title = entry.name %}
      {% endif %}

      {% assign awarder = entry.awarder %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.institution %}
      {% endif %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.颁发单位 %}
      {% endif %}
      {% if awarder == nil or awarder == '' %}
        {% assign awarder = entry.颁发机构 %}
      {% endif %}

      {% assign award_date = entry.date %}
      {% if award_date == nil or award_date == '' %}
        {% assign award_date = entry.year %}
      {% endif %}
      {% if award_date == nil or award_date == '' %}
        {% assign award_date = entry.获奖时间 %}
      {% endif %}
      {% if award_date == nil or award_date == '' %}
        {% assign award_date = entry.时间 %}
      {% endif %}

      {% assign award_summary = entry.summary %}
      {% if award_summary == nil or award_summary == '' %}
        {% assign award_summary = entry.说明 %}
      {% endif %}
      {% if award_summary == nil or award_summary == '' %}
        {% assign award_summary = entry.简介 %}
      {% endif %}

      {% if award_title and award_title != '' %}
        <li class="list-group-item">
          <div class="row">
            {% if award_date and award_date != '' %}
              <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
                <table class="table-cv">
                  <tbody>
                    <tr>
                      <td>
                        <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                          {{ award_date }}
                        </span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
            {% else %}
              <div class="col-12">
            {% endif %}
                {% if entry.url %}
                  <h6 class="title font-weight-bold ml-1 ml-md-4">
                    <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ award_title }}</a>
                  </h6>
                {% else %}
                  <h6 class="title font-weight-bold ml-1 ml-md-4">{{ award_title }}</h6>
                {% endif %}

                {% if awarder and awarder != '' %}
                  <h6 class="ml-1 ml-md-4 text-muted" style="font-size: 0.92rem">{{ awarder }}</h6>
                {% endif %}

                {% if award_summary and award_summary != '' and award_summary.first == nil %}
                  <p class="ml-1 ml-md-4 mb-1" style="font-size: 0.92rem">{{ award_summary }}</p>
                {% endif %}

                {% if entry.highlights and entry.highlights.first %}
                  <ul class="items ml-1 ml-md-4 mb-0">
                    {% for item in entry.highlights %}
                      <li><span class="item">{{ item }}</span></li>
                    {% endfor %}
                  </ul>
                {% elsif entry.亮点 and entry.亮点.first %}
                  <ul class="items ml-1 ml-md-4 mb-0">
                    {% for item in entry.亮点 %}
                      <li><span class="item">{{ item }}</span></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
          </div>
        </li>
      {% endif %}
    {% endif %}
  {% endfor %}
</ul>

{% comment %}
  Unified awards entry renderer with bilingual Chinese/English key support
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% if entry and entry != '' %}
      {% assign award_title = entry.title | default: entry.name | default: entry.奖项 | default: entry.奖项名称 %}
      {% assign awarder = entry.awarder | default: entry.institution | default: entry.organization | default: entry.颁发单位 | default: entry.颁发机构 | default: entry.赛事 %}
      {% assign award_date = entry.date | default: entry.year | default: entry.获奖时间 | default: entry.时间 | default: entry.年份 %}
      {% assign award_summary = entry.summary | default: entry.description | default: entry.说明 | default: entry.简介 %}
      {% assign award_highlights = entry.highlights | default: entry.亮点 %}

      {% if award_title and award_title != '' %}
        <li class="list-group-item">
          <div class="row">
            {% if award_date and award_date != '' %}
              <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
                <table class="table-cv">
                  <tbody>
                    <tr>
                      <td>
                        <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                          {{ award_date }}
                        </span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
            {% else %}
              <div class="col-12">
            {% endif %}
                {% if entry.url %}
                  <h6 class="title font-weight-bold ml-1 ml-md-4">
                    <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ award_title }}</a>
                  </h6>
                {% else %}
                  <h6 class="title font-weight-bold ml-1 ml-md-4">{{ award_title }}</h6>
                {% endif %}

                {% if awarder and awarder != '' %}
                  <h6 class="ml-1 ml-md-4 text-muted" style="font-size: 0.92rem">{{ awarder }}</h6>
                {% endif %}

                {% if award_summary and award_summary != '' %}
                  <p class="ml-1 ml-md-4 mb-1" style="font-size: 0.92rem">{{ award_summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
                {% endif %}

                {% if award_highlights and award_highlights.size > 0 %}
                  <ul class="items ml-1 ml-md-4 mb-0">
                    {% for item in award_highlights %}
                      <li><span class="item">{{ item }}</span></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
          </div>
        </li>
      {% endif %}
    {% endif %}
  {% endfor %}
</ul>

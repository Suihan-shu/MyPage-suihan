# Default line-ending policy for cross-platform consistency.
* text=auto

# Keep Unix tooling files with LF.
*.sh text eol=lf

# Keep web/source text assets with LF to avoid noisy CRLF/LF warnings.
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.liquid text eol=lf

# Keep Windows scripting files with CRLF for local execution comfort.
*.ps1 text eol=crlf
*.bat text eol=crlf
---
layout: default
---
<div class="post moments-page">
  <header class="post-header text-center mb-4">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div id="moments-container" class="moments-timeline">
      {% assign moments = site.data.moments %}
      {% if moments and moments.size > 0 %}
        {% for m in moments %}
          <div class="moment-entry" data-moment-id="{{ m.id }}">
            <div class="moment-dot"></div>
            <div class="moment-card">
              <div class="moment-meta">
                <span class="moment-date"><i class="fa-regular fa-clock mr-1"></i> {{ m.date }}</span>
                {% if m.location %}
                  <span class="moment-location"><i class="fa-solid fa-location-dot"></i> {{ m.location }}</span>
                {% endif %}
              </div>
              <div class="moment-body">{{ m.content }}</div>
              {% if m.images and m.images.size > 0 %}
                {% assign img_count = m.images.size %}
                <div class="moment-gallery {% if img_count == 1 %}moment-gallery-1{% elsif img_count == 2 %}moment-gallery-2{% elsif img_count == 3 %}moment-gallery-3{% elsif img_count == 4 %}moment-gallery-4{% else %}moment-gallery-multi{% endif %}">
                  {% for img in m.images %}
                    <div class="moment-gallery-item">
                      <a href="{{ img | relative_url }}" class="spotlight" data-gallery="gallery-{{ m.id }}">
                        <img src="{{ img | relative_url }}" alt="动态配图" loading="lazy">
                      </a>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              {% if m.tags and m.tags.size > 0 %}
                <div class="moment-tags-list">
                  {% for tag in m.tags %}
                    <span class="moment-tag-badge">#{{ tag }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="moment-empty-state">
          <div class="moment-empty-icon"><i class="fa-regular fa-comment-dots"></i></div>
          <p>暂时还没有发布动态。</p>
        </div>
      {% endif %}
    </div>
  </article>
</div>

<!-- 引入 Spotlight 灯箱库支持图片放大浏览 -->
{% if site.third_party_libraries.spotlight %}
  <script defer src="{{ site.third_party_libraries.spotlight.url.js }}"></script>
{% endif %}

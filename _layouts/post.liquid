---
layout: default
---
{% assign current_lang = page.lang | default: site.active_lang | default: site.default_lang %}
{% assign t = site.data.i18n[current_lang] | default: site.data.i18n.en %}
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign date_format = t.post.date_format | default: '%B %d, %Y' %}
{% assign lang_prefix = '' %}
{% unless current_lang == site.default_lang %}
  {% assign lang_prefix = '/' | append: current_lang %}
{% endunless %}
{% assign blog_base = lang_prefix | append: '/blog/' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <a class="page-back-link" href="{% if current_lang == 'zh' %}{{ '/zh/blog/' | relative_url }}{% else %}{{ '/blog/' | relative_url }}{% endif %}"><span class="page-back-link-icon" aria-hidden="true">&larr;</span><span>{{ t.nav.back_to_blog | default: 'Back to Blog' }}</span></a>
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ t.post.created_on | default: 'Created on' }} {{ page.date | date: date_format }}
      {% if page.author %}{{ t.post.by | default: 'by' }} {{ page.author }}{% endif %}
      {% if page.last_updated %}, {{ t.post.last_updated_on | default: 'last updated on' }} {{ page.last_updated | date: date_format }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      <a href="{{ blog_base | append: year | append: '/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% assign category_slug = category | slugify %}
          <a href="{{ blog_base | append: 'category/' | append: category_slug | append: '/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% elsif tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% assign tag_slug = tag | slugify %}
          <a href="{{ blog_base | append: 'tag/' | append: tag_slug | append: '/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ tag }}</a>
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>{{ t.post.references | default: 'References' }}</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

---
layout: default
---
{% assign t = site.data.i18n.zh %}
{% assign read_label = t.blog.read_label | default: '分钟阅读' %}
{% assign date_format = t.post.date_format | default: '%Y年%m月%d日' %}
<div class="post">
  <a class="page-back-link" href="{{ '/blog/' | relative_url }}"><span class="page-back-link-icon" aria-hidden="true">&larr;</span><span>{{ t.nav.back_to_blog | default: '返回博客' }}</span></a>
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}

    <hr>
    
    <ul class="post-list mt-4">
      {% assign local_posts = site.posts | where: "lang", "zh" %}
      {% assign series_posts = local_posts | where: "series_key", page.series_key | sort: "series_order" %}

      {% for post in series_posts %}
        {% if post.external_source == blank %}
          {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
        {% else %}
          {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
        {% endif %}
        {% assign year = post.date | date: "%Y" %}
        
        <li>
          {%- if post.thumbnail -%}
          <div class="row">
            <div class="col-sm-9">
          {%- endif -%}
            <h3>
              <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
            </h3>
            <p>{{ post.description }}</p>
            <p class="post-meta">
              {{ read_time }} {{ read_label }}
              &nbsp; &middot; &nbsp;
              {{ post.date | date: date_format }}
            </p>
          {%- if post.thumbnail -%}
            </div>
            <div class="col-sm-3">
              <img class="card-img" src="{{ post.thumbnail | relative_url }}" style="object-fit: cover; height: 90%" alt="{{ post.title }}缩略图">
            </div>
          </div>
          {%- endif -%}
        </li>
      {% endfor %}
    </ul>
  </article>
</div>

---
layout: default
---
{% assign cv = site.data.cv.cv %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right" aria-label="查看 PDF 简历">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
  </header>

  <article>
    <div class="cv">
      <div class="card mt-3 p-3">
        <h3 class="card-title font-weight-medium">联系方式</h3>
        {% if cv.name or cv.label or cv.location or cv.email or cv.phone or cv.website %}
          <table class="table table-cv table-sm table-borderless">
            {% if cv.name %}<tr><td class="p-1 pr-2 font-weight-bold"><b>姓名</b></td><td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td></tr>{% endif %}
            {% if cv.label %}<tr><td class="p-1 pr-2 font-weight-bold"><b>专业</b></td><td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td></tr>{% endif %}
            {% if cv.email %}<tr><td class="p-1 pr-2 font-weight-bold"><b>邮箱</b></td><td class="p-1 pl-2 font-weight-light">{{ cv.email }}</td></tr>{% endif %}
            {% if cv.phone %}<tr><td class="p-1 pr-2 font-weight-bold"><b>电话</b></td><td class="p-1 pl-2 font-weight-light">{{ cv.phone }}</td></tr>{% endif %}
            {% if cv.location %}<tr><td class="p-1 pr-2 font-weight-bold"><b>地址</b></td><td class="p-1 pl-2 font-weight-light">{{ cv.location }}</td></tr>{% endif %}
            {% if cv.website %}<tr><td class="p-1 pr-2 font-weight-bold"><b>网站</b></td><td class="p-1 pl-2 font-weight-light"><a href="{{ cv.website }}" target="_blank" rel="noopener noreferrer">{{ cv.website }}</a></td></tr>{% endif %}
          </table>
        {% else %}
          <p class="text-muted font-italic mb-0">待填写</p>
        {% endif %}
      </div>

      <div class="card mt-3 p-3">
        <h3 class="card-title font-weight-medium">个人简介</h3>
        {% if cv.summary %}
          <p>{{ cv.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% else %}
          <p class="text-muted font-italic mb-0">待填写</p>
        {% endif %}
      </div>

      {% assign section_order = '项目经历|教育经历|获奖情况|专业技能|语言能力|兴趣爱好' | split: '|' %}
      {% for section_title in section_order %}
        {% assign section_entries = cv.sections[section_title] %}
        <a class="anchor" id="{{ section_title | slugify }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
          <div>
            {% if section_entries == nil or section_entries.size == 0 %}
              <p class="text-muted font-italic mb-0">待填写</p>
            {% elsif section_title == '项目经历' %}
              {% assign entries = section_entries %}{% include cv/experience.liquid %}
            {% elsif section_title == '教育经历' %}
              {% assign entries = section_entries %}{% include cv/education.liquid %}
            {% elsif section_title == '获奖情况' %}
              {% assign entries = section_entries %}{% include cv/awards.liquid %}
            {% elsif section_title == '专业技能' %}
              {% assign entries = section_entries %}{% include cv/skills.liquid %}
            {% elsif section_title == '语言能力' %}
              {% assign entries = section_entries %}{% include cv/languages.liquid %}
            {% elsif section_title == '兴趣爱好' %}
              {% assign entries = section_entries %}{% include cv/interests.liquid %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
